rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /prompts/{promptId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      // Public-ish profile fields are readable by signed-in users for leaderboard
      // and "view other user" screens. Writes stay owner-only.
      allow read: if signedIn();
      allow write: if isOwner(uid);

      match /entries/{entryId} {
        // Journal entries (text/voice, transcripts, insights) are private.
        allow read, write: if isOwner(uid);
      }

      match /private/{docId} {
        // Private user info (PII) is always owner-only.
        allow read, write: if isOwner(uid);
      }
    }
  }
}
